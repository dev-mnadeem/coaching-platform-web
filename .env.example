# Copy to .env.local and adjust. Vite only exposes VITE_* vars to the browser
# bundle, and .env.local is git-ignored.

# GraphQL endpoint used for sign-up, sign-in and OTP confirmation.
VITE_GRAPHQL_URI=http://localhost:8000/graphql

# Optional hosted coaching model. Leave empty to use the built-in planner.
# The app never reads a provider API key in the browser - point this at a
# server-side endpoint that holds the key.
VITE_COACH_API_URL=

# Abort the hosted coaching call after this many milliseconds.
VITE_COACH_TIMEOUT_MS=12000
